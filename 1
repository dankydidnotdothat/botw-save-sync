// --- Встроенный FTP-сервер (порт 5000, корень sdmc:/) ---
static void ftp_send_str(int fd, const char *s) {
    send(fd, s, strlen(s), 0);
}

static void ftp_resolve_sd_path(const char *cwd, const char *arg, char *out_sd, size_t out_sz) {
    char combined[512];
    if (!arg || arg[0] == '\0') {
        snprintf(combined, sizeof(combined), "%s", cwd);
    } else if (arg[0] == '/') {
        snprintf(combined, sizeof(combined), "%s", arg);
    } else {
        if (strcmp(cwd, "/") == 0) snprintf(combined, sizeof(combined), "/%s", arg);
        else snprintf(combined, sizeof(combined), "%s/%s", cwd, arg);
    }
    // Убираем возможные хвостовые слэши
    size_t len = strlen(combined);
    while (len > 1 && combined[len - 1] == '/') combined[--len] = '\0';
    snprintf(out_sd, out_sz, "sdmc:%s", combined);
}

static int ftp_accept_data(int pasv_fd) {
    if (pasv_fd < 0) return -1;
    fd_set fds;
    FD_ZERO(&fds);
    FD_SET(pasv_fd, &fds);
    struct timeval tv = { 10, 0 };
    if (select(pasv_fd + 1, &fds, NULL, NULL, &tv) <= 0) return -1;
    struct sockaddr_in addr;
    socklen_t alen = sizeof(addr);
    return accept(pasv_fd, (struct sockaddr *)&addr, &alen);
}

static void ftp_handle_client(int cfd) {
    char cwd[256] = "/";
    int pasv_fd = -1;
    char line[1024];

    ftp_send_str(cfd, "220 BOTWSaveSync FTP Ready\r\n");
    add_log("FTP: PC connected");

    while (g_ftp_running) {
        fd_set rfds;
        FD_ZERO(&rfds);
        FD_SET(cfd, &rfds);
        struct timeval tv = { 1, 0 };
        int sel = select(cfd + 1, &rfds, NULL, NULL, &tv);
        if (sel == 0) continue;
        if (sel < 0) break;

        ssize_t n = 0;
        char ch;
        bool closed = false;
        while (n < (ssize_t)sizeof(line) - 1) {
            ssize_t r = recv(cfd, &ch, 1, 0);
            if (r <= 0) { closed = true; break; }
            if (ch == '\r') continue;
            if (ch == '\n') break;
            line[n++] = ch;
        }
        if (closed && n == 0) break;
        line[n] = '\0';
        if (n == 0) continue;

        char cmd[16] = {0};
        const char *arg = "";
        int ci = 0;
        while (line[ci] && !isspace((unsigned char)line[ci]) && ci < 15) {
            cmd[ci] = (char)toupper((unsigned char)line[ci]);
            ci++;
        }
        cmd[ci] = '\0';
        while (line[ci] && isspace((unsigned char)line[ci])) ci++;
        arg = line + ci;

        if (strcmp(cmd, "USER") == 0) {
            ftp_send_str(cfd, "331 Anonymous login ok\r\n");
        } else if (strcmp(cmd, "PASS") == 0) {
            ftp_send_str(cfd, "230 Logged in\r\n");
        } else if (strcmp(cmd, "SYST") == 0) {
            ftp_send_str(cfd, "215 UNIX Type: L8\r\n");
        } else if (strcmp(cmd, "FEAT") == 0) {
            ftp_send_str(cfd, "211-Features:\r\n MLSD\r\n MDTM\r\n SIZE\r\n UTF8\r\n211 End\r\n");
        } else if (strcmp(cmd, "OPTS") == 0 || strcmp(cmd, "NOOP") == 0 || strcmp(cmd, "TYPE") == 0) {
            ftp_send_str(cfd, "200 OK\r\n");
        } else if (strcmp(cmd, "PWD") == 0) {
            char resp[320];
            snprintf(resp, sizeof(resp), "257 \"%s\" is current directory\r\n", cwd);
            ftp_send_str(cfd, resp);
        } else if (strcmp(cmd, "CWD") == 0) {
            char sd_path[512];
            ftp_resolve_sd_path(cwd, arg, sd_path, sizeof(sd_path));
            struct stat st;
            if (strcmp(sd_path, "sdmc:/") == 0 || (stat(sd_path, &st) == 0 && S_ISDIR(st.st_mode))) {
                snprintf(cwd, sizeof(cwd), "%s", sd_path + 5);
                if (cwd[0] == '\0') strcpy(cwd, "/");
                ftp_send_str(cfd, "250 Directory changed\r\n");
            } else {
                ftp_send_str(cfd, "550 Directory not found\r\n");
            }
        } else if (strcmp(cmd, "CDUP") == 0) {
            char *slash = strrchr(cwd, '/');
            if (slash && slash != cwd) *slash = '\0';
            else strcpy(cwd, "/");
            ftp_send_str(cfd, "250 Directory changed\r\n");
        } else if (strcmp(cmd, "PASV") == 0) {
            if (pasv_fd >= 0) { close(pasv_fd); pasv_fd = -1; }
            pasv_fd = socket(AF_INET, SOCK_STREAM, 0);
            struct sockaddr_in paddr;
            memset(&paddr, 0, sizeof(paddr));
            paddr.sin_family = AF_INET;
            paddr.sin_addr.s_addr = INADDR_ANY;
            paddr.sin_port = 0;
            if (pasv_fd >= 0 && bind(pasv_fd, (struct sockaddr *)&paddr, sizeof(paddr)) == 0 && listen(pasv_fd, 1) == 0) {
                socklen_t plen = sizeof(paddr);
                getsockname(pasv_fd, (struct sockaddr *)&paddr, &plen);
                u16 port = ntohs(paddr.sin_port);
                u32 ip = g_ip_addr;
                char resp[128];
                snprintf(
                    resp, sizeof(resp),
                    "227 Entering Passive Mode (%u,%u,%u,%u,%u,%u)\r\n",
                    (ip >> 0) & 0xFF, (ip >> 8) & 0xFF, (ip >> 16) & 0xFF, (ip >> 24) & 0xFF,
                    (port >> 8) & 0xFF, port & 0xFF
                );
                ftp_send_str(cfd, resp);
            } else {
                if (pasv_fd >= 0) { close(pasv_fd); pasv_fd = -1; }
                ftp_send_str(cfd, "425 Cannot open passive socket\r\n");
            }
        } else if (strcmp(cmd, "MLSD") == 0 || strcmp(cmd, "LIST") == 0) {
            bool is_mlsd = (strcmp(cmd, "MLSD") == 0);
            char sd_path[512];
            ftp_resolve_sd_path(cwd, arg, sd_path, sizeof(sd_path));
            DIR *dir = opendir(sd_path);
            if (!dir) {
                ftp_send_str(cfd, "550 Cannot open directory\r\n");
            } else {
                ftp_send_str(cfd, "150 Opening data connection\r\n");
                int dfd = ftp_accept_data(pasv_fd);
                if (pasv_fd >= 0) { close(pasv_fd); pasv_fd = -1; }
                if (dfd >= 0) {
                    struct dirent *ent;
                    char child[512], entry_line[640];
                    while ((ent = readdir(dir)) != NULL) {
                        if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0) continue;
                        join_path(child, sizeof(child), sd_path, ent->d_name);
                        struct stat st;
                        memset(&st, 0, sizeof(st));
                        stat(child, &st);
                        bool is_dir = S_ISDIR(st.st_mode);
                        struct tm tmv;
                        gmtime_r(&st.st_mtime, &tmv);
                        if (is_mlsd) {
                            snprintf(
                                entry_line, sizeof(entry_line),
                                "type=%s;size=%lld;modify=%04d%02d%02d%02d%02d%02d; %s\r\n",
                                is_dir ? "dir" : "file",
                                (long long)st.st_size,
                                tmv.tm_year + 1900, tmv.tm_mon + 1, tmv.tm_mday,
                                tmv.tm_hour, tmv.tm_min, tmv.tm_sec,
                                ent->d_name
                            );
                        } else {
                            snprintf(
                                entry_line, sizeof(entry_line),
                                "%crwxrwxrwx 1 switch switch %lld Jan 01 00:00 %s\r\n",
                                is_dir ? 'd' : '-',
                                (long long)st.st_size,
                                ent->d_name
                            );
                        }
                        ftp_send_str(dfd, entry_line);
                    }
                    close(dfd);
                    ftp_send_str(cfd, "226 Transfer complete\r\n");
                } else {
                    ftp_send_str(cfd, "425 Data connection failed\r\n");
                }
                closedir(dir);
            }
        } else if (strcmp(cmd, "RETR") == 0) {
            char sd_path[512];
            ftp_resolve_sd_path(cwd, arg, sd_path, sizeof(sd_path));
            FILE *f = fopen(sd_path, "rb");
            if (!f) {
                ftp_send_str(cfd, "550 File not found\r\n");
            } else {
                ftp_send_str(cfd, "150 Opening binary data connection\r\n");
                int dfd = ftp_accept_data(pasv_fd);
                if (pasv_fd >= 0) { close(pasv_fd); pasv_fd = -1; }
                if (dfd >= 0) {
                    unsigned char *buf = (unsigned char *)malloc(COPY_BUF_SIZE);
                    if (buf) {
                        size_t r;
                        while ((r = fread(buf, 1, COPY_BUF_SIZE, f)) > 0) {
                            if (send(dfd, buf, r, 0) <= 0) break;
                        }
                        free(buf);
                    }
                    close(dfd);
                    ftp_send_str(cfd, "226 Transfer complete\r\n");
                } else {
                    ftp_send_str(cfd, "425 Data connection failed\r\n");
                }
                fclose(f);
            }
        } else if (strcmp(cmd, "STOR") == 0) {
            char sd_path[512];
            ftp_resolve_sd_path(cwd, arg, sd_path, sizeof(sd_path));
            FILE *f = fopen(sd_path, "wb");
            if (!f) {
                ftp_send_str(cfd, "550 Cannot create file\r\n");
            } else {
                ftp_send_str(cfd, "150 Ready to receive file\r\n");
                int dfd = ftp_accept_data(pasv_fd);
                if (pasv_fd >= 0) { close(pasv_fd); pasv_fd = -1; }
                if (dfd >= 0) {
                    unsigned char *buf = (unsigned char *)malloc(COPY_BUF_SIZE);
                    if (buf) {
                        ssize_t r;
                        while ((r = recv(dfd, buf, COPY_BUF_SIZE, 0)) > 0) {
                            fwrite(buf, 1, (size_t)r, f);
                        }
                        free(buf);
                    }
                    close(dfd);
                    ftp_send_str(cfd, "226 Transfer complete\r\n");
                } else {
                    ftp_send_str(cfd, "425 Data connection failed\r\n");
                }
                fclose(f);
            }
        } else if (strcmp(cmd, "MKD") == 0) {
            char sd_path[512];
            ftp_resolve_sd_path(cwd, arg, sd_path, sizeof(sd_path));
            if (mkdir_p(sd_path) == 0) ftp_send_str(cfd, "257 Directory created\r\n");
            else ftp_send_str(cfd, "550 MKD failed\r\n");
        } else if (strcmp(cmd, "DELE") == 0) {
            char sd_path[512];
            ftp_resolve_sd_path(cwd, arg, sd_path, sizeof(sd_path));
            if (unlink(sd_path) == 0) ftp_send_str(cfd, "250 Deleted\r\n");
            else ftp_send_str(cfd, "550 Delete failed\r\n");
        } else if (strcmp(cmd, "RMD") == 0) {
            char sd_path[512];
            ftp_resolve_sd_path(cwd, arg, sd_path, sizeof(sd_path));
            if (rmdir(sd_path) == 0) ftp_send_str(cfd, "250 Removed\r\n");
            else ftp_send_str(cfd, "550 RMD failed\r\n");
        } else if (strcmp(cmd, "SIZE") == 0) {
            char sd_path[512];
            ftp_resolve_sd_path(cwd, arg, sd_path, sizeof(sd_path));
            struct stat st;
            if (stat(sd_path, &st) == 0) {
                char resp[64];
                snprintf(resp, sizeof(resp), "213 %lld\r\n", (long long)st.st_size);
                ftp_send_str(cfd, resp);
            } else {
                ftp_send_str(cfd, "550 Not found\r\n");
            }
        } else if (strcmp(cmd, "MDTM") == 0) {
            char sd_path[512];
            ftp_resolve_sd_path(cwd, arg, sd_path, sizeof(sd_path));
            struct stat st;
            if (stat(sd_path, &st) == 0) {
                struct tm tmv;
                gmtime_r(&st.st_mtime, &tmv);
                char resp[64];
                snprintf(
                    resp, sizeof(resp), "213 %04d%02d%02d%02d%02d%02d\r\n",
                    tmv.tm_year + 1900, tmv.tm_mon + 1, tmv.tm_mday,
                    tmv.tm_hour, tmv.tm_min, tmv.tm_sec
                );
                ftp_send_str(cfd, resp);
            } else {
                ftp_send_str(cfd, "550 Not found\r\n");
            }
        } else if (strcmp(cmd, "QUIT") == 0) {
            ftp_send_str(cfd, "221 Goodbye\r\n");
            break;
        } else {
            ftp_send_str(cfd, "502 Command not implemented\r\n");
        }
    }

    if (pasv_fd >= 0) close(pasv_fd);
    close(cfd);
    add_log("FTP: PC disconnected");
}

static void ftp_server_thread(void *arg) {
    (void)arg;
    int sfd = socket(AF_INET, SOCK_STREAM, 0);
    if (sfd < 0) {
        mutexLock(&g_ui_mutex);
        strcpy(g_ftp_banner, "FTP: socket error");
        g_ftp_banner_color = COL_RED;
        mutexUnlock(&g_ui_mutex);
        return;
    }

    int opt = 1;
    setsockopt(sfd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    struct sockaddr_in saddr;
    memset(&saddr, 0, sizeof(saddr));
    saddr.sin_family = AF_INET;
    saddr.sin_addr.s_addr = INADDR_ANY;
    saddr.sin_port = htons(FTP_PORT);

    if (bind(sfd, (struct sockaddr *)&saddr, sizeof(saddr)) < 0 || listen(sfd, 4) < 0) {
        close(sfd);
        mutexLock(&g_ui_mutex);
        strcpy(g_ftp_banner, "FTP: port 5000 busy");
        g_ftp_banner_color = COL_CORAL;
        mutexUnlock(&g_ui_mutex);
        add_log("FTP: port 5000 already in use (sys-ftpd active?)");
        return;
    }

    if (R_SUCCEEDED(nifmGetCurrentIpAddress(&g_ip_addr)) && g_ip_addr != 0) {
        mutexLock(&g_ui_mutex);
        snprintf(
            g_ftp_banner, sizeof(g_ftp_banner),
            "FTP ON: %u.%u.%u.%u:%d",
            (g_ip_addr >> 0) & 0xFF, (g_ip_addr >> 8) & 0xFF,
            (g_ip_addr >> 16) & 0xFF, (g_ip_addr >> 24) & 0xFF,
            FTP_PORT
        );
        g_ftp_banner_color = COL_GREEN;
        mutexUnlock(&g_ui_mutex);
    } else {
        mutexLock(&g_ui_mutex);
        snprintf(g_ftp_banner, sizeof(g_ftp_banner), "FTP: No Wi-Fi (port %d)", FTP_PORT);
        g_ftp_banner_color = COL_CORAL;
        mutexUnlock(&g_ui_mutex);
    }

    while (g_ftp_running) {
        fd_set rfds;
        FD_ZERO(&rfds);
        FD_SET(sfd, &rfds);
        struct timeval tv = { 0, 250000 };
        if (select(sfd + 1, &rfds, NULL, NULL, &tv) > 0) {
            struct sockaddr_in caddr;
            socklen_t clen = sizeof(caddr);
            int cfd = accept(sfd, (struct sockaddr *)&caddr, &clen);
            if (cfd >= 0) {
                ftp_handle_client(cfd);
            }
        }
    }

    close(sfd);
}

// --- Работа с профилями и сохранениями BOTW (как в JKSV) ---
static void load_users(void) {
    AccountUid uids[MAX_USERS];
    s32 total = 0;
    Result rc = accountListAllUsers(uids, MAX_USERS, &total);
    if (R_FAILED(rc) || total <= 0) { g_user_count = 0; return; }
    g_user_count = 0;
    for (s32 i = 0; i < total && i < MAX_USERS; i++) {
        g_users[g_user_count].uid = uids[i];
        snprintf(g_users[g_user_count].nickname, sizeof(g_users[g_user_count].nickname), "User %d", i + 1);
        AccountProfile profile;
        if (R_SUCCEEDED(accountGetProfile(&profile, uids[i]))) {
            AccountProfileBase base;
            if (R_SUCCEEDED(accountProfileGet(&profile, NULL, &base))) {
                strncpy(g_users[g_user_count].nickname, base.nickname, sizeof(g_users[g_user_count].nickname) - 1);
                g_users[g_user_count].nickname[sizeof(g_users[g_user_count].nickname) - 1] = '\0';
            }
            accountProfileClose(&profile);
        }
        g_user_count++;
    }
}

static void do_dump_to_sync(AccountUid uid) {
    set_status("Exporting BOTW save -> SD Sync...", COL_CYAN);
    add_log("> Mounting BOTW save (01007EF00011E000)...");
    render_ui();

    Result rc = fsdevMountSaveData("save", BOTW_TITLE_ID, uid);
    if (R_FAILED(rc)) {
        set_status("Export failed: could not mount BOTW save", COL_RED);
        add_log("! Mount failed (0x%x). Launch BOTW once first.", rc);
        return;
    }

    mkdir_p(SYNC_DIR);
    remove_dir_contents(SYNC_DIR);

    int count = 0;
    int err = copy_dir_recursive("save:/", SYNC_DIR, &count);
    fsdevUnmountDevice("save");

    if (err == 0 && count > 0) {
        set_status("Export OK! Now click Sync on PC.", COL_GREEN);
        add_log("OK: Exported %d files to Sync folder.", count);
    } else {
        set_status("Export failed or save folder is empty.", COL_RED);
        add_log("! Export error (files=%d).", count);
    }
}

static void do_restore_from_dir(AccountUid uid, const char *src_dir, bool make_backup) {
    char opt_check[512];
    join_path(opt_check, sizeof(opt_check), src_dir, "option.sav");
    if (!file_exists(opt_check)) {
        set_status("Import failed: option.sav not found", COL_RED);
        add_log("! Missing option.sav in Sync folder.");
        return;
    }

    set_status(make_backup ? "Importing SD Sync -> BOTW..." : "Rolling back backup -> BOTW...", COL_GOLD);
    add_log("> Mounting BOTW save...");
    render_ui();

    Result rc = fsdevMountSaveData("save", BOTW_TITLE_ID, uid);
    if (R_FAILED(rc)) {
        set_status("Import failed: could not mount BOTW save", COL_RED);
        add_log("! Mount failed (0x%x). Launch BOTW once first.", rc);
        return;
    }

    if (make_backup) {
        add_log("> Creating safety backup...");
        render_ui();
        mkdir_p(BACKUP_DIR);
        remove_dir_contents(BACKUP_DIR);
        int bkp = 0;
        copy_dir_recursive("save:/", BACKUP_DIR, &bkp);
        add_log("  Backed up %d files.", bkp);
    }

    remove_dir_contents("save:/");
    int count = 0;
    int err = copy_dir_recursive(src_dir, "save:/", &count);
    if (err == 0 && count > 0) {
        rc = fsdevCommitDevice("save");
        if (R_SUCCEEDED(rc)) {
            set_status("Import OK! Changes committed to BOTW.", COL_GREEN);
            add_log("OK: Restored & committed %d files.", count);
        } else {
            set_status("Commit failed! Save not updated.", COL_RED);
            add_log("! fsdevCommitDevice failed (0x%x).", rc);
        }
    } else {
        set_status("Copy failed! Changes NOT committed.", COL_RED);
        add_log("! Copy error; save untouched.");
    }

    fsdevUnmountDevice("save");
}

int main(int argc, char *argv[]) {
    (void)argc;
    (void)argv;

    mutexInit(&g_ui_mutex);

    NWindow *win = nwindowGetDefault();
    framebufferCreate(&g_fb, win, FB_W, FB_H, PIXEL_FORMAT_RGBA_8888, 2);
    framebufferMakeLinear(&g_fb);

    padConfigureInput(1, HidNpadStyleSet_NpadStandard);
    PadState pad;
    padInitializeDefault(&pad);
    hidInitializeTouchScreen();

    // Инициализируем аккаунты как в JKSV (Administrator -> fallback Application)
    bool acc_ok = R_SUCCEEDED(accountInitialize(AccountServiceType_Administrator));
    if (!acc_ok) {
        acc_ok = R_SUCCEEDED(accountInitialize(AccountServiceType_Application));
    }
    if (acc_ok) {
        load_users();
    }

    // Создаём папку Sync заранее, чтобы ПК сразу её видел по FTP
    mkdir_p(SYNC_DIR);

    // Запускаем сеть и встроенный FTP-сервер в фоне
    socketInitializeDefault();
    nifmInitialize(NifmServiceType_User);
    g_ftp_running = true;
    if (R_SUCCEEDED(threadCreate(&g_ftp_thread, ftp_server_thread, NULL, NULL, 0x20000, 0x2C, -2))) {
        if (R_SUCCEEDED(threadStart(&g_ftp_thread))) {
            g_ftp_thread_started = true;
        }
    }

    add_log("Sync dir: %s", SYNC_DIR);
    add_log("FTP starts automatically on port 5000. Use [A] or [Y].");

    bool prev_touch = false;

    while (appletMainLoop()) {
        padUpdate(&pad);
        u64 kDown = padGetButtonsDown(&pad);
        if (kDown & HidNpadButton_Plus) break;

        HidTouchScreenState touch = {0};
        bool touch_click = false;
        int tx = 0, ty = 0;
        if (hidGetTouchScreenStates(&touch, 1) && touch.count > 0) {
            if (!prev_touch) {
                touch_click = true;
                tx = (int)touch.touches[0].x;
                ty = (int)touch.touches[0].y;
            }
            prev_touch = true;
        } else {
            prev_touch = false;
        }

        if (g_user_count > 0) {
            if (kDown & HidNpadButton_AnyUp) {
                g_selected_user = (g_selected_user - 1 + g_user_count) % g_user_count;
            } else if (kDown & HidNpadButton_AnyDown) {
                g_selected_user = (g_selected_user + 1) % g_user_count;
            } else if ((kDown & HidNpadButton_A) || (touch_click && pt_in_rect(tx, ty, BTN_EXPORT))) {
                do_dump_to_sync(g_users[g_selected_user].uid);
            } else if ((kDown & HidNpadButton_Y) || (touch_click && pt_in_rect(tx, ty, BTN_IMPORT))) {
                do_restore_from_dir(g_users[g_selected_user].uid, SYNC_DIR, true);
            } else if ((kDown & HidNpadButton_X) || (touch_click && pt_in_rect(tx, ty, BTN_ROLLBACK))) {
                do_restore_from_dir(g_users[g_selected_user].uid, BACKUP_DIR, false);
            } else if (touch_click) {
                for (s32 i = 0; i < g_user_count && i < 5; i++) {
                    Rect pr = { 60, 190 + i * 56, 324, 46 };
                    if (pt_in_rect(tx, ty, pr)) {
                        g_selected_user = i;
                        break;
                    }
                }
            }
        }

        render_ui();
    }

    g_ftp_running = false;
    if (g_ftp_thread_started) {
        threadWaitForExit(&g_ftp_thread);
        threadClose(&g_ftp_thread);
    }
    nifmExit();
    socketExit();
    if (acc_ok) accountExit();
    framebufferClose(&g_fb);
    return 0;
}
